{
  "$defs": {
    "basis": {
      "enum": [
        "holder_asserted",
        "host_computed",
        "host_configured",
        "host_observed",
        "operator_attested"
      ]
    },
    "composition": {
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/member"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "members"
      ],
      "type": "object"
    },
    "composition-rule": {
      "properties": {
        "max": {
          "type": "integer"
        },
        "member_profiles": {
          "items": {
            "$ref": "#/$defs/tagged-digest"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "min": {
          "type": "integer"
        }
      },
      "required": [
        "max",
        "member_profiles",
        "min"
      ],
      "type": "object"
    },
    "form-name": {
      "enum": [
        "artifact",
        "build",
        "configuration",
        "environment",
        "service"
      ]
    },
    "identifier": {
      "type": "string"
    },
    "identity": {
      "oneOf": [
        {
          "properties": {
            "digest": {
              "$ref": "#/$defs/tagged-digest"
            },
            "form": {
              "const": "artifact"
            }
          },
          "required": [
            "digest",
            "form"
          ],
          "type": "object"
        },
        {
          "properties": {
            "form": {
              "const": "build"
            },
            "name": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "form",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "digest": {
              "$ref": "#/$defs/tagged-digest"
            },
            "form": {
              "const": "configuration"
            }
          },
          "required": [
            "digest",
            "form"
          ],
          "type": "object"
        },
        {
          "properties": {
            "contract": {
              "$ref": "#/$defs/tagged-digest"
            },
            "enrollment": {
              "$ref": "#/$defs/tagged-digest"
            },
            "form": {
              "const": "service"
            },
            "published": {
              "$ref": "#/$defs/tagged-digest"
            }
          },
          "required": [
            "contract",
            "enrollment",
            "form"
          ],
          "type": "object"
        },
        {
          "properties": {
            "digest": {
              "$ref": "#/$defs/tagged-digest"
            },
            "form": {
              "const": "environment"
            }
          },
          "required": [
            "digest",
            "form"
          ],
          "type": "object"
        }
      ]
    },
    "instance": {
      "properties": {
        "binds": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "id",
        "identity",
        "provenance",
        "role"
      ],
      "type": "object"
    },
    "member": {
      "properties": {
        "deployment_digest": {
          "$ref": "#/$defs/tagged-digest"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "deployment_digest",
        "id"
      ],
      "type": "object"
    },
    "principal": {
      "oneOf": [
        {
          "properties": {
            "key": {
              "$ref": "#/$defs/tagged-digest"
            }
          },
          "required": [
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "enrollment": {
              "$ref": "#/$defs/tagged-digest"
            }
          },
          "required": [
            "enrollment"
          ],
          "type": "object"
        }
      ]
    },
    "principal-rule": {
      "enum": [
        "forbidden",
        "optional",
        "required"
      ]
    },
    "procedure": {
      "additionalProperties": false,
      "properties": {
        "composition": {
          "$ref": "#/$defs/composition"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/instance"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      },
      "required": [
        "instances",
        "profile"
      ],
      "type": "object"
    },
    "profile": {
      "properties": {
        "composition": {
          "$ref": "#/$defs/composition-rule"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/role-rule"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "roles"
      ],
      "type": "object"
    },
    "provenance": {
      "properties": {
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "evidence": {
          "$ref": "#/$defs/tagged-digest"
        },
        "principal": {
          "$ref": "#/$defs/principal"
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      },
      "required": [
        "basis"
      ],
      "type": "object"
    },
    "relation": {
      "properties": {
        "relation": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "relation",
        "target"
      ],
      "type": "object"
    },
    "relation-rule": {
      "properties": {
        "max": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "relation": {
          "$ref": "#/$defs/identifier"
        },
        "target_role": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "max",
        "min",
        "relation",
        "target_role"
      ],
      "type": "object"
    },
    "requirement": {
      "enum": [
        "optional",
        "required"
      ]
    },
    "role-rule": {
      "properties": {
        "bases": {
          "items": {
            "$ref": "#/$defs/basis"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "covers": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/requirement"
        },
        "exact": {
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 128,
          "minItems": 0,
          "type": "array"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/form-name"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "max": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "principal": {
          "$ref": "#/$defs/principal-rule"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/relation-rule"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "schema": {},
        "validity": {
          "$ref": "#/$defs/requirement"
        }
      },
      "required": [
        "bases",
        "evidence",
        "forms",
        "max",
        "min",
        "principal",
        "role",
        "validity"
      ],
      "type": "object"
    },
    "tagged-digest": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "validity": {
      "properties": {
        "not_after": {
          "$ref": "#/$defs/timestamp"
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "not_before"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/procedure"
}
