{
  "name": "@agent-blueprint-protocol/verifier",
  "version": "1.0.1",
  "description": "Installable verifier for the Agent Blueprint Protocol: canonical-bytes, digest, signature, bounds, and conformance-corpus verification. Non-authorizing: evidence, never a decision.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/agent_blueprint_protocol.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-blueprint-protocol": "dist/kit/cli.mjs",
    "verifier": "dist/kit/cli.mjs"
  },
  "files": [
    "dist/verifier",
    "!dist/verifier/self_checks.*",
    "dist/kit",
    "dist/corpus",
    "dist/spec",
    "dist/release-metadata.json",
    "dist/release-history.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build_kit.mjs --clean && node node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/build_kit.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^7.0.2",
    "typescript-floor": "npm:typescript@5.0.2"
  },
  "keywords": [
    "agent",
    "protocol",
    "verifier",
    "conformance",
    "interoperability",
    "mcp",
    "a2a"
  ],
  "exports": {
    ".": {
      "types": "./dist/verifier/index.d.ts",
      "import": "./dist/verifier/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/verifier/index.d.ts"
}
