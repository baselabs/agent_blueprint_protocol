```
%{blueprint_value: true, envelope_decoded: true}
```

## Inspect the registry

Registry states may grow. This reader matches the names used here and preserves an unknown state as unknown.

The shipped registry contains only the active and deprecated federation registrations. Read both entries.

```elixir
alias AgentBlueprintProtocol.ExtensionRegistry

registry = ExtensionRegistry.registered_extensions()

registry_view =
  Enum.map(registry, fn entry ->
    state =
      case entry.state do
        :active -> :active
        :deprecated -> :deprecated
        :retired -> :retired
        other -> {:unknown_state, other}
      end

    {entry.namespace, entry.criticality, state, entry.schema_digest != nil}
  end)

registry_view
```

<!-- livebook:{"output":true} -->

```
[
  {"com.example/federation", :critical, :deprecated, true},
  {"io.github.baselabs/federation", :critical, :active, true}
]
```

## Negotiate extension outcomes

The helper composes each extension map from the shipped Blueprint value and recomputes the Blueprint digest. A supplied support registry can include a retired namespace without changing the compiled registry.

Create Blueprints for active critical, deprecated, unknown, and retired namespace cases, then negotiate each one.

```elixir
alias AgentBlueprintProtocol.{Blueprint, Canonicalization, Digest, Negotiation}
alias AgentBlueprintProtocol.ExtensionRegistry

put_member = fn {:object, members}, name, value ->
  {:object, List.keystore(members, name, 0, {name, value})}
end

make_blueprint = fn regions ->
  value = put_member.(base_value, "extensions", regions)
  {:ok, draft} = Blueprint.from_value(value)
  digest = draft |> Blueprint.content_digest() |> Digest.to_tagged()
  value = put_member.(value, "content_digest", {:string, digest})
  {:ok, bytes} = Canonicalization.encode(value)
  AgentBlueprintProtocol.decode_blueprint(bytes)
end

empty_body = {:object, []}
regions = fn critical, optional ->
  {:object, [
    {"critical", {:object, critical}},
    {"optional", {:object, optional}}
  ]}
end

{:ok, active_critical} =
  make_blueprint.(regions.([{"io.github.baselabs/federation", empty_body}], []))

{:ok, deprecated_critical} =
  make_blueprint.(regions.([{"com.example/federation", empty_body}], []))

{:ok, unknown_optional} =
  make_blueprint.(regions.([], [{"com.example.vendor/unknown", empty_body}]))

{:ok, unknown_critical} =
  make_blueprint.(regions.([{"com.example.vendor/absent", empty_body}], []))

retired_entry = %ExtensionRegistry{
  namespace: "com.example.vendor/archive",
  owner: "ExampleVendor",
  criticality: :optional,
  state: :retired,
  schema_digest: nil,
  a2a_uri: "https://example.com/extensions/archive",
  promoted_at_revision: nil
}

{:ok, retired_optional} =
  make_blueprint.(regions.([], [{"com.example.vendor/archive", empty_body}]))

support = %Negotiation.Support{
  revisions: MapSet.new([1]),
  registry: %{"com.example.vendor/archive" => retired_entry},
  schemas: %{
    "com.example/federation" => ExtensionRegistry.federation_schema(),
    "io.github.baselabs/federation" => ExtensionRegistry.federation_schema()
  }
}

outcome = fn result ->
  case result do
    {:ok, value} ->
      Enum.map(value.notices, fn
        :extension_deprecated -> :deprecated
        :extension_retired -> :retired
        :extension_unknown_optional_retained -> :unknown_optional
        other -> {:unknown_notice, other}
      end)

    {:error, error} ->
      error.code
  end
end

%{
  active_critical: outcome.(AgentBlueprintProtocol.negotiate(active_critical, support)),
  deprecated_critical: outcome.(AgentBlueprintProtocol.negotiate(deprecated_critical, support)),
  unknown_optional: outcome.(AgentBlueprintProtocol.negotiate(unknown_optional, support)),
  unknown_critical: outcome.(AgentBlueprintProtocol.negotiate(unknown_critical, support)),
  retired_optional: outcome.(AgentBlueprintProtocol.negotiate(retired_optional, support))
}
```

<!-- livebook:{"output":true} -->

```
%{
  unknown_optional: [:unknown_optional],
  active_critical: [],
  deprecated_critical: [:deprecated],
  unknown_critical: :extension_unknown_critical,
  retired_optional: [:retired]
}
```

## Supply a schema-pinned critical extension

The active federation namespace has a registered schema digest. Negotiation checks the supplied schema against that registry entry.

Negotiate an empty federation extension body using the registered schema document.

```elixir
federation_namespace = "io.github.baselabs/federation"
schema = ExtensionRegistry.federation_schema()

schema_support = %Negotiation.Support{
  revisions: MapSet.new([1]),
  schemas: %{federation_namespace => schema}
}

%{
  schema_available: is_map(schema_support.schemas),
  negotiated:
    match?(
      {:ok, %Negotiation.Outcome{critical_extensions: [^federation_namespace]}},
      AgentBlueprintProtocol.negotiate(active_critical, schema_support)
    )
}
```

<!-- livebook:{"output":true} -->

```
%{schema_available: true, negotiated: true}
```

## Register a host-owned critical namespace

The host supplies a generic example registration and its schema document. It
computes the pin from canonical schema bytes. The compiled registry is unchanged.

```elixir
namespace = "com.example.vendor/record"
{:ok, document} = AgentBlueprintProtocol.Json.decode(~s({"additionalProperties":false,"properties":{"value":{"type":"string"}},"required":["value"],"type":"object"}))
{:ok, schema_bytes} = Canonicalization.encode(document)
pin = Digest.to_tagged(Digest.hash(:extension_schema, schema_bytes))

host_entry = %ExtensionRegistry{
  namespace: namespace,
  owner: "ExampleVendor",
  criticality: :critical,
  state: :active,
  schema_digest: pin,
  a2a_uri: "https://example.com/extensions/record",
  promoted_at_revision: nil
}

host_support = %Negotiation.Support{
  revisions: MapSet.new([1]),
  registry: %{namespace => host_entry},
  schemas: %{namespace => document}
}
{:ok, host_blueprint} = make_blueprint.(regions.([{namespace, {:object, [{"value", {:string, "one"}}]}}], []))

%{
  registered: outcome.(AgentBlueprintProtocol.negotiate(host_blueprint, host_support)),
  missing_registration: outcome.(AgentBlueprintProtocol.negotiate(host_blueprint, %Negotiation.Support{revisions: MapSet.new([1])})),
  missing_schema: outcome.(AgentBlueprintProtocol.negotiate(host_blueprint, %{host_support | schemas: %{}})),
  mismatched_schema: outcome.(AgentBlueprintProtocol.negotiate(host_blueprint, %{host_support | schemas: %{namespace => {:object, [{"type", {:string, "object"}}]}}})),
  shipped_entries: length(ExtensionRegistry.registered_extensions())
}
```

<!-- livebook:{"output":true} -->

```
%{
  registered: [],
  missing_registration: :extension_unknown_critical,
  missing_schema: :extension_schema_unavailable,
  mismatched_schema: :extension_schema_digest_mismatch,
  shipped_entries: 2
}
```

## Read the shipped envelope and state codecs

The decoder reads the package example. The state codecs map a logical state to each carrier vocabulary, and the carrier codecs round-trip the decoded envelope.

```elixir
alias AgentBlueprintProtocol.Federation

{:ok, envelope_bytes} = Federation.canonical_bytes(federation)
{:ok, a2a_carrier} = Federation.to_a2a_carrier(federation)
{:ok, mcp_carrier} = Federation.to_mcp_carrier(federation)
{:ok, a2a_round_trip} = Federation.from_a2a_carrier(a2a_carrier)
{:ok, mcp_round_trip} = Federation.from_mcp_carrier(mcp_carrier)

{:ok, a2a_state} = Federation.from_a2a_state("TASK_STATE_COMPLETED")
{:ok, mcp_state} = Federation.from_mcp_state("completed")
{:ok, a2a_spelling} = Federation.to_a2a_state(a2a_state)
{:ok, mcp_spelling} = Federation.to_mcp_state(mcp_state)

%{
  envelope_decoded: is_struct(federation, Federation),
  state_codecs_agree: a2a_state == mcp_state,
  a2a_spelling: a2a_spelling,
  mcp_spelling: mcp_spelling,
  a2a_round_trip: Federation.canonical_bytes(a2a_round_trip) == {:ok, envelope_bytes},
  mcp_round_trip: Federation.canonical_bytes(mcp_round_trip) == {:ok, envelope_bytes}
}
```

<!-- livebook:{"output":true} -->

```
%{
  a2a_round_trip: true,
  mcp_round_trip: true,
  a2a_spelling: "TASK_STATE_COMPLETED",
  mcp_spelling: "completed",
  envelope_decoded: true,
  state_codecs_agree: true
}
```

## Read the mapping table

The mapping rows are data. Match the known row fields and keep a catch-all for rows with a future shape.

```elixir
mapping =
  AgentBlueprintProtocol.federation_mapping()
  |> Enum.map(fn
    %{logical_field: field, a2a_location: a2a, mcp_location: mcp, verdict: verdict} ->
      {field, a2a, mcp, verdict}

    other ->
      {:unknown_row, is_struct(other)}
  end)

mapping
```

