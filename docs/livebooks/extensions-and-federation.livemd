## Check shipped commitment fixtures

The shipped conformance cases demonstrate a valid terminal commitment and a conflicting terminal commitment. The receiver supplies public `keys` or an `issuer_key_sets` map (which takes precedence), optional exact `issuer`/`subject`/`audience` pins, inclusive `created_after`/`created_before` timestamp strings, and previously verified `prior_receipts`. See the [receiver-context field table](../../documentation/federation.md#receiver-context-and-returned-facts). Success returns the task identity, terminal state, and terminal commitment digest as a verified fact; it supplies no host execution behavior.

```elixir
case_path =
  Path.join([
    Application.app_dir(:agent_blueprint_protocol, "priv/conformance"),
    "cases",
    "federation-verify_commitment.json"
  ])

fixture_cases = JSON.decode!(File.read!(case_path))["cases"]
valid_case = Enum.find(fixture_cases, &(&1["id"] == "commitment-valid"))
conflict_case = Enum.find(fixture_cases, &(&1["id"] == "commitment-terminal-conflict"))

key_from = fn item ->
  {:ok, key_bytes} = Base.url_decode64(item["key"], padding: false)

  %AgentBlueprintProtocol.Signature.PublicKey{
    key_id: item["key_id"],
    algorithm: :ed25519,
    key: key_bytes
  }
end

{:ok, valid_envelope} = Federation.decode(valid_case["input"]["envelope"])
valid_keys = Enum.map(valid_case["input"]["context"]["keys"], key_from)

valid_result =
  Federation.verify_commitment(valid_envelope, %Federation.Context{keys: valid_keys})

{:ok, conflict_envelope} = Federation.decode(conflict_case["input"]["envelope"])
conflict_context = conflict_case["input"]["context"]
conflict_keys = Enum.map(conflict_context["keys"], key_from)

prior =
  Enum.map(conflict_context["prior_receipts"], fn item ->
    {:ok, digest} = AgentBlueprintProtocol.Digest.from_tagged(item["commitment"])

    %{
      task_identity: item["task_identity"],
      terminal_state: item["terminal_state"],
      terminal_commitment: digest
    }
  end)

conflict_result =
  Federation.verify_commitment(
    conflict_envelope,
    %Federation.Context{keys: conflict_keys, prior_receipts: prior}
  )

%{
  valid_fixture:
    case valid_result do
      {:ok, %{task_identity: task, terminal_state: state, terminal_commitment: digest}} ->
        %{
          task_identity: task,
          terminal_state: state,
          terminal_commitment: Digest.to_tagged(digest)
        }

      {:error, error} ->
        {:denied, error.code}
    end,
  conflict_fixture:
    case conflict_result do
      {:error, error} -> error.code
      {:ok, _} -> :accepted
    end
}
```

<!-- livebook:{"output":true} -->

```
%{
  valid_fixture: %{
    task_identity: "task-7f3a2c",
    terminal_commitment: "sha-256:Ub1fvxQros48cb7vgXGpEzQwww5-DSZn9MDkY5XU5VU",
    terminal_state: "completed"
  },
  conflict_fixture: :federation_terminal_conflict
}
```

